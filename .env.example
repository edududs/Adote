# Copy to .env and fill in. Never commit .env.
# Development: DJANGO_DEBUG=1 is enough; everything else has a local default.

DJANGO_DEBUG=1
# Required when DJANGO_DEBUG is off. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Comma-separated. Required when DJANGO_DEBUG is off.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins with scheme, when the app is behind another domain or port.
DJANGO_CSRF_TRUSTED_ORIGINS=
# Defaults to SQLite in the repository root. Production: postgres://user:password@host:5432/adote
DATABASE_URL=
# Behind a proxy that terminates TLS these stay on; turn the redirect off only for local HTTP.
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_HSTS_SECONDS=31536000
# Serve uploaded photos from Django itself. On in debug; in production prefer the proxy.
DJANGO_SERVE_MEDIA=
DJANGO_MEDIA_ROOT=
DJANGO_STATIC_ROOT=
DJANGO_LOG_LEVEL=INFO

# Links inside e-mails point here.
ADOTE_SITE_URL=http://localhost:8000
# E-mail goes to the console unless EMAIL_HOST is set.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Adote <nao-responda@adote.local>
