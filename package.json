{
  "name": "adote-assets",
  "private": true,
  "description": "Builds the Tailwind stylesheet the Django app serves. Only needed to change the styles.",
  "scripts": {
    "build:css": "tailwindcss --input assets/css/app.css --output src/adote/shared/adapters/static/adote/css/app.css --minify",
    "watch:css": "tailwindcss --input assets/css/app.css --output src/adote/shared/adapters/static/adote/css/app.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@tailwindcss/forms": "0.5.11",
    "tailwindcss": "4.3.3"
  }
}
